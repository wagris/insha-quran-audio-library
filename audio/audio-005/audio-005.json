{
  "text_overlays": [
    {
      "text": "وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ",
      "font_family": "Amiri",
      "start_time": 0.0,
      "end_time": 11.055
    },
    {
      "text": "وَإِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌۭ ۖ",
      "font_family": "Amiri",
      "start_time": 11.055,
      "end_time": 16.162
    },
    {
      "text": "فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ",
      "font_family": "Amiri",
      "start_time": 16.162,
      "end_time": 21.877
    },
    {
      "text": "إِنَّ رَبَّكَ هُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ",
      "font_family": "Amiri",
      "start_time": 21.877,
      "end_time": 29.702
    },
    {
      "text": "وَلَقَدْ ءَاتَيْنَـٰكَ سَبْعًۭا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ",
      "font_family": "Amiri",
      "start_time": 29.702,
      "end_time": 41.23
    },
    {
      "text": "لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًۭا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ",
      "font_family": "Amiri",
      "start_time": 41.23,
      "end_time": 62.1
    },
    {
      "text": "وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ",
      "font_family": "Amiri",
      "start_time": 62.1,
      "end_time": 72.674
    },
    {
      "text": "كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ",
      "font_family": "Amiri",
      "start_time": 72.674,
      "end_time": 82.872
    }
  ]
}
